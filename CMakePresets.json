{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe",
        "CMAKE_RC_COMPILER": "C:/Program Files/LLVM/bin/llvm-rc.exe"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Clang Release",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Clang Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Clang Release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows Clang Debug + ASan",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "cacheVariables": {
        "ENABLE_ASAN": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Clang Debug + ASan",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "windows-coverage",
      "displayName": "Windows Clang Debug + Coverage",
      "inherits": "windows-debug",
      "binaryDir": "${sourceDir}/build/windows-coverage",
      "cacheVariables": {
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux Clang Debug + Coverage",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/build/linux-coverage",
      "cacheVariables": {
        "ENABLE_COVERAGE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-asan", "configurePreset": "windows-asan" },
    { "name": "windows-coverage", "configurePreset": "windows-coverage" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" }
  ]
}
